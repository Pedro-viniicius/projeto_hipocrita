# Variáveis de ambiente do "Pão de Cada Dia".
# Copie para .env e ajuste: `cp .env.example .env`. O .env nunca vai para o git.
# Variável em branco (VAR=) usa o padrão indicado. true/false aceita também 1/0, sim/não.

# --- Básico -----------------------------------------------------------------

# Modo de desenvolvimento: mostra erros detalhados e serve /_estilos/.
# Em branco: false, exceto no compose.yaml local, que liga (true).
# Em produção, deixe em branco ou false (o compose.prod.yaml força false).
DEBUG=

# Chave secreta do Django: assina sessões e tokens e gera o HMAC do limite de
# tentativas. Obrigatória com DEBUG=false (o app não sobe sem ela).
# Gere com: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
# Trocar a chave desloga todo mundo e invalida links de redefinição de senha.
SECRET_KEY=

# Domínios aceitos, separados por vírgula. Ex.: paodecadadia.exemplo.com.br
# Padrão: localhost, 127.0.0.1 e [::1] com DEBUG=true; vazio (nada) sem DEBUG.
ALLOWED_HOSTS=

# Origens HTTPS confiáveis para o CSRF, com esquema. Ex.: https://paodecadadia.exemplo.com.br
# Necessário quando o site roda atrás de proxy com HTTPS.
# Na Vercel: https://<projeto>.vercel.app. Nunca use curinga como https://*.vercel.app:
# qualquer pessoa cria um projeto nesse domínio.
CSRF_TRUSTED_ORIGINS=

# Fuso da comunidade: "hoje", 23h59 e horário de encerramento são calculados nele.
# Padrão: America/Sao_Paulo.
COMMUNITY_TZ=America/Sao_Paulo

# Carrega anúncios de exemplo marcados "(exemplo)" ao subir com docker/start-dev.sh.
# Em branco: false, exceto no compose.yaml local, que liga (true).
# Produção: o compose.prod.yaml força false.
# Desligada, os dados de exemplo saem da vitrine (continuam no banco até rodar
# `load_demo --remove`) e não são recarregados.
DEMO_DATA=

# Nível de log da aplicação (DEBUG, INFO, WARNING, ERROR). Padrão: INFO.
# O log de consultas ao banco nunca sai em DEBUG (pode conter dado pessoal).
LOG_LEVEL=INFO

# --- Banco de dados (PostgreSQL 17) ----------------------------------------

# Host do PostgreSQL. Vazio = SQLite local (só para rodar testes fora do Docker).
# No compose, o próprio compose define "db".
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=paodecadadia
POSTGRES_USER=paodecadadia
# Senha do banco. Obrigatória no compose.prod.yaml. Use uma senha longa e aleatória.
POSTGRES_PASSWORD=
# Segundos que uma conexão fica aberta para reuso. Padrão: 60.
# Com o pooler do Neon (Vercel), 60 também serve: a conexão é testada antes do reuso.
DB_CONN_MAX_AGE=60
# Desliga os cursores no servidor do PostgreSQL. Padrão: false.
# Use true quando o app fala com o banco por um pooler em modo transação (o host
# "-pooler" do Neon, PgBouncer): ali o cursor se perde entre uma transação e outra.
DB_DISABLE_SERVER_SIDE_CURSORS=false

# Só na Vercel com Neon. A libpq lê estas direto do ambiente (o app não as lê).
# Ficam comentadas de propósito: "PGSSLMODE=" em branco quebraria a conexão no
# compose local. Defina-as no painel da Vercel, não aqui.
# PGSSLMODE=require
# PGCHANNELBINDING=require
# Host do Neon SEM "-pooler" (conexão direta). Injetada pelo Neon e lida só pelo
# scripts/vercel_build.sh, que roda o migrate por ela no build de produção.
# PGHOST_UNPOOLED=

# Caminho do arquivo SQLite quando POSTGRES_HOST está vazio. Padrão: ./db.sqlite3.
SQLITE_PATH=

# --- HTTPS, cookies e proxy -------------------------------------------------

# Cookies de sessão e CSRF só por HTTPS. Padrão: true com DEBUG=false, false com DEBUG=true.
# Só desligue para testar a imagem de produção em http://localhost.
COOKIE_SECURE=

# Ligue quando um proxy (Caddy, Fly, Railway, Vercel) termina o HTTPS e envia
# X-Forwarded-Proto. Sem proxy, deixe false (o cabeçalho poderia ser forjado).
SECURE_PROXY_SSL_HEADER=false

# Redireciona http → https no próprio app. Padrão: false (o Caddy/Fly já redireciona).
# /healthz nunca é redirecionado.
SECURE_SSL_REDIRECT=false

# HSTS: segundos que o navegador lembra de usar só HTTPS. Padrão: 0 (desligado).
# Depois de confirmar que o HTTPS funciona, use 31536000 (1 ano).
SECURE_HSTS_SECONDS=0

# Quantos proxies confiáveis ficam na frente do app, para achar o IP real no
# X-Forwarded-For (usado só no limite de tentativas, como HMAC).
# 0 = ignora o cabeçalho (acesso direto). VPS com Caddy: 1. Fly.io: 1. Railway: 1.
# Vercel: 1 (ela troca o X-Forwarded-For pelo IP do visitante). Se puser outro
# proxy na frente da Vercel (ex.: Cloudflare com proxy ligado), o valor muda.
# Valor alto demais deixa o limite ser burlado; baixo demais põe todos no IP do proxy.
TRUSTED_PROXY_HOPS=0

# IPs dos quais o gunicorn aceita X-Forwarded-*. Padrão: 127.0.0.1.
# Com o Caddy em outro container ou em PaaS, use o IP do proxy ou "*".
# Não se aplica na Vercel (lá não há gunicorn).
FORWARDED_ALLOW_IPS=127.0.0.1

# Fontes extras de imagem no Content-Security-Policy (separadas por vírgula).
# Com S3, o domínio do bucket já entra sozinho; use só para casos especiais.
CSP_EXTRA_IMG_SRC=

# --- Fotos ------------------------------------------------------------------

# Tamanho máximo de cada foto enviada, em MB. Padrão: 5 (3 fotos por anúncio).
# Também define o teto do corpo de qualquer requisição: 3 × este valor + 1 MB
# (16 MB no padrão). Acima disso o app responde 413. Se houver proxy na frente
# (Caddy, nginx), o limite dele precisa ser igual ou maior.
# Na Vercel use 1: ela recusa requisição com mais de 4,5 MB, e 3 × 1 + 1 = 4 MB
# cabe. O navegador reduz as fotos antes de enviar; sem JavaScript, cada foto
# pode ter até 1 MB.
MAX_UPLOAD_MB=5

# Onde guardar as fotos: local (disco/volume, padrão) ou s3.
# Na Vercel use s3 (Cloudflare R2): a função não tem disco que dure.
STORAGE_BACKEND=local

# Pasta das fotos com STORAGE_BACKEND=local. Na imagem Docker: /data/media
# (montada como volume). Fora do Docker, padrão: ./media.
MEDIA_ROOT=

# Com STORAGE_BACKEND=s3 (AWS S3, Cloudflare R2, Tigris, Backblaze B2...):
AWS_STORAGE_BUCKET_NAME=
# Credenciais lidas direto pelo boto3. Use uma chave restrita a este bucket.
# Use chave estática (de usuário ou token do R2); credencial temporária
# (AWS_SESSION_TOKEN) não é usada.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Região do bucket. R2 usa "auto". Ex.: us-east-1
AWS_S3_REGION_NAME=
# Endpoint para provedores compatíveis com S3. Vazio = AWS.
# Ex.: https://<conta>.r2.cloudflarestorage.com ou https://fly.storage.tigris.dev
AWS_S3_ENDPOINT_URL=
# Domínio público/CDN do bucket, se houver (sem https://).
AWS_S3_CUSTOM_DOMAIN=
# URLs assinadas e temporárias (recomendado: bucket privado). Padrão: true.
AWS_QUERYSTRING_AUTH=true
# Validade das URLs assinadas, em segundos. Padrão: 3600.
AWS_QUERYSTRING_EXPIRE=3600

# --- E-mail (recuperação de senha) -----------------------------------------

# Como o e-mail de recuperação de senha sai. Padrão: console.
# - console (django.core.mail.backends.console.EmailBackend): o e-mail é impresso
#   no terminal. Só para desenvolvimento: com DEBUG=false a recuperação de senha
#   fica DESLIGADA (o link com o token iria parar no log do servidor). O link
#   "Esqueceu a senha?" some e a página pede para falar com a administração, que
#   troca a senha com `python manage.py changepassword <email>`. Antes, confira
#   a identidade: só atenda pedido vindo do e-mail da conta e mande a senha nova
#   só para esse e-mail.
# - smtp (django.core.mail.backends.smtp.EmailBackend): envia de verdade e liga a
#   recuperação em produção. Preencha as variáveis abaixo com os dados do seu
#   provedor (Brevo, Mailgun, Amazon SES, Gmail com senha de app etc.).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Servidor SMTP do provedor. Ex.: smtp-relay.brevo.com
EMAIL_HOST=
# Porta: 587 com STARTTLS (EMAIL_USE_TLS=true), o comum. Padrão: 587.
EMAIL_PORT=587
# Usuário e senha (ou chave de API) do SMTP. A senha é segredo: só no .env.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# STARTTLS na conexão SMTP. Padrão: true. Não desligue em produção.
EMAIL_USE_TLS=true
# Remetente dos e-mails. Use um endereço do domínio autorizado no provedor.
DEFAULT_FROM_EMAIL=nao-responda@localhost

# --- Regras do produto ------------------------------------------------------

# Dias até uma venda pontual sem reconfirmação sair da lista pública. Padrão: 14.
RECONFIRM_DAYS=14

# Teto de contas novas por dia no site inteiro, somando todos os visitantes,
# contra cadastro em massa. Conta só conta criada (envio com erro não gasta).
# O dia vira à meia-noite UTC (21h em Brasília). Atingido o teto, o cadastro
# mostra "os cadastros de hoje se esgotaram" até a virada. 0 fecha o cadastro:
# o aviso diz que ele está fechado, sem prometer data para reabrir.
# Padrão: 50.
SIGNUPS_PER_DAY=50

# --- Privacidade (LGPD) -----------------------------------------------------

# Quem responde pelos dados pessoais do site (o controlador, pela LGPD) e o
# e-mail para quem quiser saber, corrigir ou apagar os próprios dados sem
# precisar entrar na conta. Aparecem na página /privacidade/. O e-mail também
# aparece como link em "Entrar" e "Recuperar senha" (com a recuperação desligada) e
# no aviso de cadastro fechado ou esgotado do dia.
# Vazias, a página mostra "Responsável: a definir", as outras telas dizem que ainda
# não há contato e `check --deploy` avisa (core.W001). Preencha antes de publicar.
# Ex.: PRIVACY_CONTROLLER_NAME=Maria Souza (organizadora do Pão de Cada Dia)
PRIVACY_CONTROLLER_NAME=
# Ex.: PRIVACY_CONTACT_EMAIL=privacidade@seu.dominio
PRIVACY_CONTACT_EMAIL=

# --- Limpeza agendada (Vercel) ---------------------------------------------

# Segredo da rota /_tarefas/limpeza/, que roda o `cleanup_data` quando chamada
# com o cabeçalho "Authorization: Bearer <segredo>" (Vercel Cron e GitHub Actions).
# Vazio (padrão): a rota fica desligada e responde 404. Na VPS deixe vazio: lá a
# limpeza é o cron do servidor (README).
# Gere com: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Use só letras, números, "-" e "_" (vai num cabeçalho HTTP), com pelo menos 32
# caracteres; o `check --deploy` avisa (core.W002) se não for assim. Na Vercel, marque
# como Sensitive; cadastre o mesmo valor no GitHub (Settings → Secrets → Actions).
CRON_SECRET=

# --- Servidor ---------------------------------------------------------------
# Nada desta seção se aplica na Vercel: lá não há container nem gunicorn.

# Porta interna do app no container. Padrão: 8000 (Fly e Railway podem definir).
PORT=8000
# Porta publicada pelo compose, só em 127.0.0.1 (não fica exposta na rede).
# Padrão: 8000.
WEB_PORT=8000
# Processos e threads do gunicorn (produção). Padrão: 2 e 2.
WEB_CONCURRENCY=2
GUNICORN_THREADS=2
# Tempo máximo de uma requisição no gunicorn, em segundos. Padrão: 30.
GUNICORN_TIMEOUT=30
# Nível do log do gunicorn. Padrão: info.
GUNICORN_LOG_LEVEL=info
